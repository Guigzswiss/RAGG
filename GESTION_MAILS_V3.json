    {
      "parameters": {
        "jsCode": "// Parse la reponse du LLM et prepare le payload pour le pipeline complet\nconst text = $input.first().json.text;\nconst clean = text.replace(/```json|```/g, '').trim();\nconst parsed = JSON.parse(clean);\n\nconst pieces_jointes = $('Microsoft Outlook Trigger').first().json.body.pieces_jointes;\n\nreturn [{\n  json: {\n    client: parsed.client,\n    type_document: parsed.type_document,\n    annee: parsed.annee,\n    pieces_jointes: pieces_jointes || [],\n    imprimer: false\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
