      ],
      "id": "54474326-d616-4ce2-8692-8e01410a2cb5",
      "name": "Preparer Classement"
    },
    {
      "parameters": {
        "jsCode": "// Prepare les pieces jointes pour impression uniquement\nconst pieces_jointes = $('Microsoft Outlook Trigger').first().json.body.pieces_jointes;\n\n// Pour PIECES, on envoie au pipeline complet avec impression activee\n// Le client/type/annee sont generiques car le but est d'imprimer\nreturn [{\n  json: {\n    client: 'A_CLASSER',\n    type_document: 'Pieces',\n    annee: new Date().getFullYear().toString(),\n    pieces_jointes: pieces_jointes || [],\n    imprimer: true\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
